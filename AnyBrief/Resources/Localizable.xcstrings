    "Picks a prompt from the Prompts tab and passes its text to the model as extra context — e.g. who's on the mic, or names to use for generic speaker labels. Shared with transcript cleanup below, so it only needs to be set once." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picks a prompt from the Prompts tab and passes its text to the model as extra context — e.g. who's on the mic, or names to use for generic speaker labels. Shared with transcript cleanup below, so it only needs to be set once."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Берёт промпт с вкладки «Промпты» и передаёт его текст модели как дополнительный контекст — например, кто говорит в микрофон, или какие имена подставлять вместо обезличенных меток спикеров. Общий с очисткой транскрипта ниже, поэтому достаточно задать один раз."
          }
        }
      }
    },
    "Picks a prompt from the Prompts tab and passes its text to the model as extra context — e.g. who's on the mic, or names to use for generic speaker labels. Shared with the Summary tab, so it only needs to be set once." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picks a prompt from the Prompts tab and passes its text to the model as extra context — e.g. who's on the mic, or names to use for generic speaker labels. Shared with the Summary tab, so it only needs to be set once."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Берёт промпт с вкладки «Промпты» и передаёт его текст модели как дополнительный контекст — например, кто говорит в микрофон, или какие имена подставлять вместо обезличенных меток спикеров. Общий с вкладкой «Саммари», поэтому достаточно задать один раз."
          }
        }
      }
    },
