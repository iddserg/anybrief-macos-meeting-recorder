        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляет диаризацией спикеров. Автоопределение позволяет модели выбрать число; календарь может использовать количество участников; фиксированное значение задаёт точное число спикеров."
          }
        }
      }
    },
    "Lower values split speech into more speakers. Higher values merge similar voices and produce fewer speakers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower values split speech into more speakers. Higher values merge similar voices and produce fewer speakers."
