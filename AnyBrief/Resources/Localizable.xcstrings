    "Runs after transcription and before summarization: fixes recognition errors and fills in speaker names using calendar context. Overwrites the transcript with the cleaned version, so the summary and any exports use it too." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs after transcription and before summarization: fixes recognition errors and fills in speaker names using calendar context. Overwrites the transcript with the cleaned version, so the summary and any exports use it too."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполняется после транскрибации и перед саммаризацией: исправляет ошибки распознавания и подставляет имена спикеров из контекста календаря. Перезаписывает транскрипт очищенной версией, поэтому саммари и экспорт используют её."
          }
        }
      }
    },
    "Speaker names come from the Speaker context field on the Summary tab, which is shared with this step." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speaker names come from the Speaker context field on the Summary tab, which is shared with this step."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имена спикеров берутся из поля «Контекст спикеров» на вкладке «Саммари» — оно общее с этим шагом."
          }
