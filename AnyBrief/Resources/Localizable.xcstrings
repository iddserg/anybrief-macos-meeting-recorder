      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Check API before launching CLI" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверять API перед запуском CLI" } }
      }
    },
    "Checks that the Codex or Claude API is reachable before starting the CLI. If the domain is blocked or unavailable, AnyBrief immediately tries the next LLM connection." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Checks that the Codex or Claude API is reachable before starting the CLI. If the domain is blocked or unavailable, AnyBrief immediately tries the next LLM connection." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверяет доступность API Codex или Claude перед запуском CLI. Если домен заблокирован или недоступен, AnyBrief сразу переходит к следующему LLM-подключению." } }
      }
    },
    "Prevents Codex from loading user plugins, MCP servers, and settings for this request. Authentication is still used." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Prevents Codex from loading user plugins, MCP servers, and settings for this request. Authentication is still used." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не позволяет Codex загружать пользовательские плагины, MCP-серверы и настройки для этого запроса. Авторизация продолжает использоваться." } }
      }
    },
    "Controls speaker diarization. Calendar and maximum count set an upper limit; exact count forces N speakers and uses a fallback if the model returns another count." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Controls speaker diarization. Calendar and maximum count set an upper limit; exact count forces N speakers and uses a fallback if the model returns another count." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Управляет диаризацией спикеров. Календарь и максимальное число задают верхнюю границу; точное число требует N спикеров и использует fallback, если модель вернула другое количество." } }
      }
    },
