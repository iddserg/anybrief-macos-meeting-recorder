    "CLI runs from the transcript folder. It can return Markdown in stdout or write summary.md itself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CLI runs from the transcript folder. It can return Markdown in stdout or write summary.md itself."
