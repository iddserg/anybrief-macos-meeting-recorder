          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяет режим обработки голоса микрофона Apple. Он может уменьшить эхо и фоновый шум, но немного изменить тембр голоса."
          }
        }
      }
    },
    "Controls speaker diarization. Auto-detect lets the model choose; calendar can use participant count; fixed count forces an exact number of speakers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controls speaker diarization. Auto-detect lets the model choose; calendar can use participant count; fixed count forces an exact number of speakers."
